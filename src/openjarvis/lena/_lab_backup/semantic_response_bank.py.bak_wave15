        cluster = cls._select_uncertainty_cluster()
        return pools[cluster][mode]

    @classmethod
    def _uncertainty_continuity(cls) -> list[str]:
        cluster = cls._select_uncertainty_cluster()
        pools = {
            "dispersion": [
                "e a linha ainda continua se desfazendo.",
                "e isso ainda perde sequência rápido.",
                "e o pensamento continua escapando da trilha.",
            ],
            "suspension": [
                "e continua faltando fechamento interno.",
                "e isso ainda interrompe antes de concluir.",
                "e nada parece terminar por dentro.",
            ],
            "noise": [
                "e a nitidez ainda não aparece.",
                "e isso continua meio turvo internamente.",
                "e o ruído ainda toma a frente.",
            ],
            "misalignment": [
                "e as partes ainda não sincronizam.",
                "e isso continua sem compasso interno.",
                "e o ajuste ainda não aconteceu.",
            ],
            "metacognitive": [
                "e você continua vendo a mente não consolidar.",
                "e a tentativa ainda não sedimenta.",
                "e isso continua sem condensação real.",
            ],
        }
        return pools[cluster]

