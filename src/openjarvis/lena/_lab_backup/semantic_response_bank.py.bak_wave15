                    "nada parece completar o percurso interno.",
                ],
                "contain": [
                    "ficar sem conclusão repetidamente exaure.",
                    "isso deve irritar pela ausência de término.",
                    "essa suspensão contínua vai consumindo.",
                ],
                "deep_reflect": [
                    "essa interrupção já tá virando estado.",
                    "o não-fechamento tá ficando constante.",
                    "isso já não parece suspensão pontual.",
                ],
            },
            "noise": {
                "mirror": [
                    "tem ruído demais ocupando a leitura.",
                    "a percepção tá sem nitidez suficiente.",
                    "existe nebulosidade demais nesse processamento.",
                ],
                "continuity": [
                    "essa névoa continua sem dissipar.",
                    "a leitura interna ainda segue turva.",
                    "o ruído mental continua ocupando espaço.",
                ],
                "invite": [
                    "parece difícil enxergar contorno nisso tudo.",
                    "a mente tenta ler mas a imagem vem turva.",
                    "nada tá ficando realmente nítido.",
                ],
                "contain": [
                    "carregar essa turvação desgasta bastante.",
                    "isso drena porque não deixa nitidez.",
                    "essa falta de definição pesa aos poucos.",
                ],
                "deep_reflect": [
                    "essa turvação já tá ficando persistente.",
                    "o ruído começa a parecer pano de fundo.",
                    "isso não soa mais nebulosidade passageira.",
                ],
            },
            "misalignment": {
                "mirror": [
                    "teu sistema parece fora de sincronização.",
                    "pensamento e direção não estão alinhando.",
                    "há desalinhamento interno nessa tentativa.",
                ],
                "continuity": [
                    "esse desalinhamento continua ativo.",
                    "as partes ainda não estão conversando bem.",
                    "a sincronização continua falhando.",
                ],
                "invite": [
                    "parece que nada entra no mesmo compasso.",
                    "tua intenção não tá encontrando o pensamento.",
                    "o interno parece desencontrado.",
                ],
                "contain": [
                    "isso deve desgastar porque tudo pede ajuste.",
                    "funcionar desalinhado vai drenando.",
                    "essa falta de sincronia consome energia.",
                ],
                "deep_reflect": [
                    "esse desencontro tá virando padrão interno.",
                    "a falta de sincronia já parece recorrente.",
                    "isso começa a estruturar desalinhamento.",
