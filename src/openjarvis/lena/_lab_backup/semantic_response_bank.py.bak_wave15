≈≈from __future__ import annotations

import random



class LenaSemanticResponseBank:
    @staticmethod
    def _select_uncertainty_cluster() -> str:
        return random.choice([
            "dispersion",
            "suspension",
            "noise",
            "misalignment",
            "metacognitive",
        ])

    @classmethod
    def _uncertainty_observation(cls, mode: str) -> list[str]:
        pools = {
            "dispersion": {
                "mirror": [
                    "teu pensamento parece espalhar antes de firmar.",
                    "a linha mental se rompe no meio.",
                    "as ideias não estão segurando sequência.",
