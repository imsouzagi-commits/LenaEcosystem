            },
            "metacognitive": {
                "mirror": [
                    "você percebe a tentativa de pensar sem consolidar.",
                    "a própria mente nota que não captura.",
                    "tem esforço cognitivo sem sedimentação.",
                ],
                "continuity": [
                    "essa tentativa sem captura continua voltando.",
                    "o esforço mental ainda não consolida nada.",
