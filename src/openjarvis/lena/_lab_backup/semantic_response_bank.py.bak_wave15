    @classmethod
    def _domain_observation(cls, topic: str, mode: str) -> list[str]:
        pools = {
            "practical_analysis": {
                "mirror": [
                    "o ponto central dessa decisão tá no tradeoff.",
                    "a diferença aparece mais na estrutura do que na superfície.",
                    "isso depende menos de gosto e mais de custo operacional.",
                ],
                "continuity": [
                    "esse tipo de decisão continua girando em impacto estrutural.",
                    "o peso ainda tá em manutenção versus ganho.",
                    "a análise continua sendo retorno contra complexidade.",
                ],
                "invite": [
                    "vale olhar onde isso muda operação de verdade.",
                    "a pergunta certa é onde isso compensa no fluxo.",
                    "o núcleo é entender o custo escondido dessa escolha.",
                ],
                "contain": [
                    "tem mais variável técnica nisso do que parece.",
                    "essa comparação exige pesar arquitetura com calma.",
                    "não é uma troca tão linear quanto soa.",
                ],
                "deep_reflect": [
                    "isso mexe principalmente em manutenção futura.",
                    "a decisão tem consequência mais arquitetural que imediata.",
                    "o impacto real aparece na escala e na continuidade.",
                ],
            },
            "factual_reference": {
                "mirror": [
                    "o dado central aqui é bem objetivo.",
                    "a referência principal nesse caso é direta.",
                    "isso tem uma definição relativamente fechada.",
                ],
                "continuity": [
                    "a resposta continua dentro desse mesmo eixo factual.",
                    "a referência permanece a mesma nesse ponto.",
                    "o significado não muda muito fora disso.",
                ],
                "invite": [
                    "vale localizar o dado base primeiro.",
                    "o melhor é fixar a referência objetiva antes.",
                    "a leitura começa pelo fato principal.",
                ],
                "contain": [
                    "isso é mais questão de referência do que interpretação.",
                    "a resposta fica bem ancorada em definição.",
                    "não tem tanta elasticidade semântica aqui.",
                ],
                "deep_reflect": [
                    "o contexto só aprofunda um dado já estabelecido.",
                    "a ampliação vem mais por detalhe do que por mudança.",
                    "a base factual continua sólida.",
                ],
            },
            "social_presence": {
                "mirror": ["tô aqui.", "te ouvi.", "sim."],
                "continuity": ["continuo aqui contigo.", "ainda te ouvindo.", "seguindo aqui."],
                "invite": ["pode falar.", "me diz.", "continua."],
                "contain": ["tô te acompanhando.", "sim, tô aqui.", "te acompanho."],
                "deep_reflect": ["continua.", "pode ir.", "te escuto."],
            },
        }
        return pools.get(topic, pools["practical_analysis"])[mode]

    @classmethod
    def _domain_continuity(cls, topic: str) -> list[str]:
        pools = {
            "practical_analysis": [
                "e a diferença pesa no longo prazo.",
                "e isso muda conforme a escala do projeto.",
                "e o custo aparece mais na manutenção.",
            ],
            "factual_reference": [
                "e a referência continua nessa linha.",
                "e o dado permanece dentro disso.",
                "e o sentido principal segue esse.",
            ],
            "social_presence": [
                "continuo aqui.",
                "seguindo.",
                "te ouvindo.",
            ],
        }
        return pools.get(topic, pools["practical_analysis"])

    @classmethod
    def _domain_relational(cls, topic: str) -> list[str]:
        pools = {
            "practical_analysis": [
                "eu tô olhando mais para arquitetura nisso.",
                "a comparação pesa mais em consequência técnica.",
