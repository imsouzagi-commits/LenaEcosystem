            ],
        }
        return pools.get(topic, pools["practical_analysis"])

    @classmethod
    def _domain_bridge(cls, topic: str) -> list[str]:
        pools = {
            "practical_analysis": [
                "o núcleo da análise passa por aí.",
                "é aí que a decisão começa a mudar.",
                "esse é o ponto de sustentação da escolha.",
            ],
            "factual_reference": [
                "isso parte dessa referência.",
                "a base objetiva é essa.",
                "o eixo factual começa aí.",
            ],
            "social_presence": [
                "tô aqui.",
                "sim.",
                "te ouvindo.",
            ],
        }
        return pools.get(topic, pools["practical_analysis"])

    @classmethod
    def _domain_greeting(cls, topic: str) -> list[str]:
        pools = {
            "practical_analysis": ["oi.", "fala.", "tô aqui."],
            "factual_reference": ["oi.", "sim.", "manda."],
            "social_presence": ["oi, thiago.", "oi.", "tô aqui."],
        }
        return pools.get(topic, pools["social_presence"])

    @staticmethod
    def observation_fragments(topic: str, mode: str) -> list[str]:
        if topic == "uncertainty":
            return LenaSemanticResponseBank._uncertainty_observation(mode)
        return LenaSemanticResponseBank._domain_observation(topic, mode)

    @staticmethod
    def continuity_fragments(topic: str) -> list[str]:
        if topic == "uncertainty":
            return LenaSemanticResponseBank._uncertainty_continuity()
        return LenaSemanticResponseBank._domain_continuity(topic)

    @staticmethod
    def relational_fragments(topic: str, mode: str) -> list[str]:
        if topic == "uncertainty":
            return LenaSemanticResponseBank._uncertainty_relational()
        return LenaSemanticResponseBank._domain_relational(topic)

    @staticmethod
    def bridge_fragments(topic: str) -> list[str]:
        if topic == "uncertainty":
            return LenaSemanticResponseBank._uncertainty_bridge()
        return LenaSemanticResponseBank._domain_bridge(topic)

    @staticmethod
    def greeting_fragments(topic: str) -> list[str]:
        if topic == "uncertainty":
            return ["oi.", "tô aqui.", "oi, thiago."]
        return LenaSemanticResponseBank._domain_greeting(topic)

    @staticmethod
    def soften(memory, text: str) -> str:
        social = memory.social_state

        if social.warmth_level >= 5 and random.random() < 0.20:
            return random.choice([
                text,
                text + " eu tô aqui.",
                text + " pode ir falando.",
            ])

        if social.intimacy_level >= 6 and random.random() < 0.12:
            return random.choice([
                text,
                text + " tô te ouvindo.",
            ])

        return text
