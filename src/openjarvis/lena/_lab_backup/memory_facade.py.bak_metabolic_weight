    def _semantic_topic_scores(self, lowered: str) -> tuple[dict[str, float], list[tuple[str, str]]]:
        normalized = lowered.lower().strip()
        weighted_clusters = self._semantic_clusters()

        scores: dict[str, float] = {}
        matched_roots: list[tuple[str, str]] = []

        for topic, clusters in weighted_clusters.items():
            topic_score = 0.0

            for cluster in clusters:
                if isinstance(cluster, tuple):
                    weight, cluster_roots = cluster
                    shade = None
                else:
                    weight = cluster["weight"]
                    cluster_roots = cluster["roots"]
                    shade = cluster.get("shade")

                hit = None
                for root in cluster_roots:
                    if self._semantic_root_hit(normalized, root):
                        hit = root
                        break

                if hit:
                    topic_score += weight
                    matched_roots.append((topic, shade, hit, weight))

            if self._matches_learned_topic(normalized, topic):
                topic_score += 2.0

            topic_score += min(0.35, self.recent_topic_windows.get(topic, 0) * 0.05)

            if self.social_state.current_topic == topic and self._is_contextual_continuation(normalized) and topic_score < 2.4:
                topic_score += 0.06

            if topic_score > 0:
                scores[topic] = topic_score

        return scores, matched_roots

    def _semantic_emotion_topic(self, lowered: str) -> str | None:
        scores, _ = self._semantic_topic_scores(lowered)
        if not scores:
            return None

        priority = {
            "mental_noise": 6,
            "uncertainty": 5,
            "fatigue": 4,
            "clarity_seek": 3,
            "stagnation": 2,
            "disconnection": 1,
        }

        ranked = sorted(scores.items(), key=lambda x: (x[1], priority.get(x[0], 0)), reverse=True)
        return ranked[0][0]

    def govern_semantic_fusion(self, user_text: str, fused: list[str]) -> tuple[str, str | None, str | None]:
        lowered = user_text.lower().strip()

        semantic_topics = {"fatigue", "mental_noise", "disconnection", "stagnation", "clarity_seek", "uncertainty"}

        if self._is_contextual_continuation(lowered):
            current = self.social_state.current_topic
            lexical_strength = 0.0
            if fused:
                scores, _ = self._semantic_topic_scores(lowered)
                lexical_strength = max(scores.values()) if scores else 0.0

            if current in semantic_topics and lexical_strength < 2.2:
                if current not in fused:
                    fused = fused + [current]
                fused = fused[:3]

            elif not fused:
                fused = ["uncertainty", "stagnation"]

        if not fused:
            fused = ["uncertainty"]

        primary = fused[0] if len(fused) >= 1 else None
        secondary = fused[1] if len(fused) >= 2 else None
        latent = fused[2] if len(fused) >= 3 else None

        return primary or "uncertainty", secondary, latent

    def detect_semantic_topic(self, user_text: str) -> str | None:
        fused = self.detect_semantic_topic_fusion(user_text)
        primary, _, _ = self.govern_semantic_fusion(user_text, fused)
        return primary

    def detect_semantic_topic_fusion(self, user_text: str) -> list[str]:
        lowered = user_text.lower().strip()

        contextual = self._contextual_semantic_topic(lowered)
        scores, matched_roots = self._semantic_topic_scores(user_text)

        if contextual and scores.get(contextual, 0) < 2.5:
            scores[contextual] = scores.get(contextual, 0) + 0.55

        if not scores:
            return ["uncertainty"]

        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)
        top_score = ranked[0][1]

        cluster = [topic for topic, score in ranked if top_score - score <= 4.2][:3]

        if contextual and contextual not in cluster:
            cluster = [contextual] + cluster
            cluster = cluster[:3]

        return cluster


    def retrieve_semantic_echoes(self, primary: str, secondary: str | None = None, latent: str | None = None) -> dict:
        topics = {x for x in (primary, secondary, latent) if x}

        echo_snippets = []
        for snippet in reversed(self.semantic_emotional_snippets):
            if not isinstance(snippet, dict):
                continue

            if snippet.get("topic") in topics:
                echo_snippets.append(str(snippet.get("text", "")).strip())
            if len(echo_snippets) >= 3:
                break

        echo_responses = []
        for topic in topics:
            for resp in reversed(self.semantic_response_history.get(topic, [])):
                echo_responses.append(resp.strip())
                if len(echo_responses) >= 3:
                    break
            if len(echo_responses) >= 3:
                break

        familiarity_density = min(10, len(echo_snippets) * 2 + len(echo_responses))

        return {
            "echo_snippets": echo_snippets,
            "echo_responses": echo_responses,
            "familiarity_density": familiarity_density,
        }


    def _infer_primary_shade(self, primary: str, lowered: str, matched_roots: list[tuple[str, str]]) -> str | None:
        roots = " ".join(root for topic, root in matched_roots if topic == primary)

        if primary == "stagnation":
            blob = lowered + " " + roots
            if any(x in blob for x in ["rodando", "voltando", "circuito", "repet"]):
                return "recurrence_loop"
            if any(x in blob for x in ["soltar", "preso", "prende", "aderido"]):
                return "adhesive_hold"
            if any(x in blob for x in ["sem margem", "cansando", "gastando"]):
                return "exhaustion"
            return "immobility"

        if primary == "fatigue":
            blob = lowered + " " + roots
            if any(x in blob for x in ["acordei", "não recomp", "nao recomp", "não zera", "nao zera"]):
                return "no_recovery"
            if any(x in blob for x in ["básico", "basico", "simples", "mínimo", "minimo"]):
                return "basic_weight"
            return "depletion"

        if primary == "uncertainty":
            blob = lowered + " " + roots
            if any(x in blob for x in ["faltando", "peça", "peca"]):
                return "missing_piece"
            return "open_unresolved"

        if primary == "mental_noise":
            blob = lowered + " " + roots
            if any(x in blob for x in ["embaralh", "atropel", "foco"]):
                return "fragmentation"
            if any(x in blob for x in ["aquiet", "abaixa", "sossega"]):
                return "no_quiet"
            return "turbulence"

        if primary == "clarity_seek":
            if any(x in lowered for x in ["organizar", "estruturar", "linha"]):
                return "structuring"
            return "closure_search"

        return None

    def build_semantic_packet(self, user_text: str) -> LenaSemanticPacket:

        lowered_cache = user_text.strip().lower()
        if self._packet_cache_text == lowered_cache and self._packet_cache_obj is not None:
            return self._packet_cache_obj

        lowered = user_text.lower().strip()
        contextual = self._contextual_semantic_topic(lowered)
        scores, matched_roots = self._semantic_topic_scores(user_text)

        if contextual and scores.get(contextual, 0) < 2.5:
            scores[contextual] = scores.get(contextual, 0) + 0.55

        ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True) if scores else [("uncertainty", 1.0)]
        top_score = ranked[0][1]

        fused = []
        for topic, score in ranked:
            if score >= (top_score * 0.62) or score >= 4.2:
                fused.append(topic)

        root_topic_diversity = list(dict.fromkeys(item[0] for item in matched_roots))
        for topic in root_topic_diversity:
            if topic not in fused:
                fused.append(topic)

        if contextual and contextual not in fused and top_score < 4.5:
            fused = [contextual] + fused

        fused = fused[:3]

        if not fused:
            fused = ["uncertainty"]

        primary = fused[0]
        session_hits = self.session_semantic_hits.get(primary, 0) + 1
        secondary = fused[1] if len(fused) >= 2 else None
        latent = fused[2] if len(fused) >= 3 else None

        primary_candidates = [x for x in matched_roots if x[0] == primary and x[1]]
        primary_candidates.sort(key=lambda x: x[3], reverse=True)
        primary_shade = primary_candidates[0][1] if primary_candidates else None

        recurrence = int(self.recent_topic_windows.get(primary, 0))
        unresolved = int(self.social_state.unresolved_loops)
        depth = int(self.social_state.conversation_depth)

        confidence = (recurrence * 0.8) + (unresolved * 1.2) + (depth * 0.45)

        if confidence <= 1.8:
            continuity_stage = 0
        elif confidence <= 3.8:
            continuity_stage = 1
        elif confidence <= 6.2:
            continuity_stage = 2
        elif confidence <= 8.8:
            continuity_stage = 3
        else:
            continuity_stage = 4

        pressure_raw = (
            recurrence * 0.25 +
            unresolved * 0.90 +
            self.social_state.emotional_gravity * 0.75 +
            self.social_state.presence_momentum * 0.30
        )
        response_pressure = int(round(min(10, pressure_raw)))

        if primary == "fatigue" or (response_pressure >= 7 and continuity_stage >= 2):
            mode = "contain"
        elif primary in {"clarity_seek", "uncertainty"} and continuity_stage <= 1:
            mode = "invite"
        elif continuity_stage >= 2:
            mode = "continuity"
        else:
            mode = "mirror"

        stance = "compress" if response_pressure >= 4 else "observe"

        echoes = self.retrieve_semantic_echoes(primary, secondary, latent)

        packet = LenaSemanticPacket(
            primary_topic=primary,
            primary_shade=primary_shade,
            secondary_topic=secondary,
            latent_topic=latent,
            raw_scores=scores,
            matched_roots=matched_roots,
            continuation_flag=self._is_contextual_continuation(lowered),
            recurrence=recurrence,
            continuity_stage=continuity_stage,
            response_pressure=response_pressure,
            mode=mode,
            stance=stance,
            echo_snippets=echoes["echo_snippets"],
            echo_responses=echoes["echo_responses"],
            familiarity_density=min(10, int(session_hits + recurrence)),
            session_hits=session_hits,
        )

        self._packet_cache_text = lowered_cache
        self._packet_cache_obj = packet
        return packet


    def commit_semantic_packet(self, packet: LenaSemanticPacket) -> None:
        if not packet or not packet.primary_topic:
            return
        self.session_semantic_hits[packet.primary_topic] = self.session_semantic_hits.get(packet.primary_topic, 0) + 1


    def _is_contextual_continuation(self, lowered: str) -> bool:
        continuation_markers = (
            "ainda", "continua", "continuo", "continua igual", "no mesmo", "mesma coisa",
            "suspenso", "nao acabou", "não acabou", "isso continua", "isso ainda", "segue isso", "de novo nisso",
        )

        if len(lowered.split()) == 1 and lowered not in {"continua", "de novo"}:
            return False

        return any(marker in lowered for marker in continuation_markers)


    def _contextual_semantic_topic(self, lowered: str) -> str | None:
        lexical = self._semantic_emotion_topic(lowered)
        if lexical:
            return lexical

        if not self._is_contextual_continuation(lowered):
            return None

        social = self.social_state

        if social.unresolved_loops < 3:
            return None

        if social.current_topic in {
            "fatigue",
            "mental_noise",
            "disconnection",
            "stagnation",
            "clarity_seek",
            "uncertainty",
        }:
            return social.current_topic

        return None

    def _matches_learned_topic(self, lowered: str, topic: str) -> bool:
        patterns = self.learned_patterns.get(topic, [])
        return any(p.lower() in lowered for p in patterns)

