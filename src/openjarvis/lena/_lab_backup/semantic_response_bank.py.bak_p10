        pools = {
            "fatigue": [
                "e isso ainda não foi embora, né?",
                "não parece ter cedido ainda.",
                "e continua no teu sistema.",
                "e isso ainda fica te acompanhando.",
                "e não parece dissolver.",
                "e isso segue ocupando espaço.",
