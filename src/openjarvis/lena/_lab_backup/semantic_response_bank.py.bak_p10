            "uncertainty": [
                "e continua difícil organizar tudo, né?",
                "e ainda não tá encaixando direito.",
                "e isso segue sem formar conclusão.",
                "e continua sem fechar internamente.",
                "e ainda não virou clareza.",
                "e isso continua meio suspenso.",
            ],
            "distress": [
                "e isso continua te pressionando.",
                "e ainda não parece ter baixado.",
                "e isso segue comprimindo.",
                "e a carga ainda tá alta.",
                "e isso continua sem alívio.",
                "e a tensão não afrouxou.",
