    @staticmethod
    def greeting_fragments(topic: str) -> list[str]:
        pools = {
            "fatigue": ["oi.", "oi de novo.", "oi, tô aqui.", "oi, te ouvi.", "voltei."],
            "uncertainty": ["oi.", "oi de novo.", "oi, te ouvi.", "voltei.", "oi, continuo aqui."],
            "distress": ["oi.", "oi de novo.", "oi, tô aqui.", "oi, te ouvi.", "voltei."],
        }
        return pools.get(topic, ["oi."])

    @staticmethod
    def resolution_fragments(topic: str) -> list[str]:
        return [
            "agora isso começou a formar algum contorno.",
            "já dá para sentir um pouco mais de encaixe.",
            "pelo menos não tá tão solto quanto antes.",
            "isso começou a assentar minimamente.",
        ]

    @staticmethod
    def soften(memory, text: str) -> str:
        social = memory.social_state

        if social.warmth_level >= 5 and random.random() < 0.20:
            return random.choice([
                text,
                text + " eu tô aqui.",
                text + " pode ir falando.",
            ])

        if social.intimacy_level >= 6 and random.random() < 0.12:
            return random.choice([
                text,
                text + " tô te ouvindo.",
            ])

        return text
