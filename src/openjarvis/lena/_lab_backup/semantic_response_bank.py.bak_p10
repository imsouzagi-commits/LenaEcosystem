    @staticmethod
    def invitation_fragments(topic: str, mode: str) -> list[str]:
        if mode == "contain":
            return [
                "pode continuar.",
                "não precisa cortar agora.",
                "vai me dizendo.",
            ]
        return [
            "me mostra onde isso trava mais.",
            "me diz o que tá mais difícil nisso.",
            "continua um pouco nessa linha.",
        ]

